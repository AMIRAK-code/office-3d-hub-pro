# Copy to .env and fill in. Never commit .env.

# single = one office (dedicated install, default); hosted = many workspaces (the SaaS)
MODE=single
PORT=3000
DATA_DIR=./data

# Behind Caddy / nginx / Cloudflare Tunnel: trust one proxy hop so rate limits see real visitor IPs.
TRUST_PROXY=1

# ---- hosted mode ----
# Workspaces are reachable at <slug>.BASE_DOMAIN (needs a wildcard DNS record *.BASE_DOMAIN).
BASE_DOMAIN=office3dhub.example
# Long random secret for the operator API (/_platform/api). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLATFORM_TOKEN=

# ---- single mode: only used the first time, to create the workspace ----
OFFICE_NAME=Acme Studio
OFFICE_PASSCODE=
OFFICE_ADMINS=Jane Doe
